---
const apiUrl = import.meta.env.PUBLIC_API_URL?.trim();

if (!apiUrl) {
  throw new Error('Missing PUBLIC_API_URL. Set it in the build environment before deploying the frontend.');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="The canonical Chaos Garden state." />
    <title>Chaos Garden</title>
  </head>
  <body>
    <main data-api-url={apiUrl}>
      <p>Canonical Chaos Garden</p>
      <h1 id="tick">Loading current epoch…</h1>
      <p id="population">The Worker is the sole curator of this ecosystem.</p>
      <p id="status" role="status"></p>
    </main>

    <script>
      interface CanonicalState {
        tick: number;
        epoch: number;
        populationSummary: {
          plants: number;
          herbivores: number;
          carnivores: number;
          fungi: number;
        };
      }

      interface GardenResponse {
        ok: boolean;
        data?: {
          canonicalState: CanonicalState;
        };
      }

      const root = document.querySelector<HTMLElement>('main[data-api-url]');
      const tick = document.querySelector<HTMLElement>('#tick');
      const population = document.querySelector<HTMLElement>('#population');
      const status = document.querySelector<HTMLElement>('#status');

      async function loadCanonicalGarden(): Promise<void> {
        if (!root || !tick || !population || !status) {
          return;
        }

        try {
          const response = await fetch(`${root.dataset.apiUrl}/api/garden`);
          const payload = await response.json() as GardenResponse;
          const canonicalState = payload.ok ? payload.data?.canonicalState : undefined;

          if (!response.ok || !canonicalState) {
            throw new Error('The canonical garden state is unavailable.');
          }

          const { plants, herbivores, carnivores, fungi } = canonicalState.populationSummary;
          tick.textContent = `Epoch ${canonicalState.epoch}, tick ${canonicalState.tick}`;
          population.textContent = `${plants} plants · ${herbivores} herbivores · ${carnivores} carnivores · ${fungi} fungi`;
          status.textContent = 'Live state supplied by the scheduled Worker.';
        } catch (error) {
          status.textContent = error instanceof Error ? error.message : 'Unable to load the canonical garden state.';
        }
      }

      void loadCanonicalGarden();
    </script>
  </body>
</html>
