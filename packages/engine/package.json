{
  "name": "@chaos-garden/engine",
  "version": "2.0.0",
  "description": "Standalone, deterministic, zero-allocation ECS biological simulation engine",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc",
    "sim:run": "npx tsx src/cli/sim.ts",
    "audit:sim": "npx tsx src/cli/audit.ts"
  },
  "dependencies": {
    "@chaos-garden/shared": "file:../shared"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}

