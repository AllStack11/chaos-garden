{
  "name": "@chaos-garden/client",
  "version": "1.0.0",
  "description": "Hardware-accelerated living terrarium client powered by PixiJS v8, Svelte 5, Web Audio, and Web Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chaos-garden/engine": "file:../engine",
    "@chaos-garden/shared": "file:../shared",
    "idb": "^8.0.2",
    "pixi.js": "^8.6.6",
    "svelte": "^5.2.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.1",
    "autoprefixer": "^10.4.20",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^3.2.4"
  }
}
