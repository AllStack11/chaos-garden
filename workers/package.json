{
  "name": "@chaos-garden/workers",
  "version": "1.0.0",
  "description": "Cloudflare Workers backend for Chaos Garden simulation",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev -e dev --config wrangler.local.jsonc --persist-to .wrangler/local-state",
    "backend": "npm run dev",
    "deploy:workers": "npm run deploy",
    "deploy": "npm run build -w @chaos-garden/engine && wrangler deploy",
    "db:init:local": "node scripts/init-canonical-db.js",
    "db:init:remote": "node scripts/init-canonical-db.js --remote",
    "test": "vitest run tests/unit",
    "test:watch": "vitest tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run tests/unit tests/integration --coverage",
    "test:ci": "npm run type-check && npm run test:coverage",
    "test:all": "npm run test:ci",
    "tail": "wrangler tail -e dev",
    "clean": "echo '🧹 Workers: No build artifacts to clean'",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@chaos-garden/shared": "file:../packages/shared",
    "cross-spawn": "^7.0.6",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "miniflare": "^3.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.63.0"
  }
}
